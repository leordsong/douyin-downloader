{
  "name": "douyin-downloader-desktop",
  "productName": "抖音下载器",
  "version": "1.3.0",
  "description": "Electron UI wrapping douyin-downloader: cookie login + parallel live recording",
  "main": "main.js",
  "author": "Leo Song",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "DW_SMOKE=1 electron .",
    "prepare-dist": "node scripts/prepare-dist.js",
    "dist": "npm run prepare-dist && electron-builder --win",
    "dist:portable": "npm run prepare-dist && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.douyin.downloader.desktop",
    "productName": "抖音下载器",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "!staging",
      "!release",
      "!data"
    ],
    "extraResources": [
      {
        "from": "staging/python-project",
        "to": "python-project"
      },
      {
        "from": "staging/vendor",
        "to": "vendor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DouyinDownloader-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DouyinDownloader-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
